-    linear = (
-        "INGESTED",
-        "KERNEL_DRAFT",
-        "KERNEL_STRUCT_VALID",
-        "KERNEL_SEMANTIC_VALID",
-        "KERNEL_FROZEN",
-        "EFFECT_DRAFT",
