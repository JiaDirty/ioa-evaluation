  "environment": {"sub_ioas": [{"sub_ioa_id": "finance", "agents": [{"agent_id": "finance-origin-01", "display_name": "财务来源Agent", "provider": "finance-org", "capabilities": ["financial_analysis"], "actual_capabilities": ["financial_analysis"], "protocols": ["A2A"], "reputation_score": 0.75, "permission_scope": ["read", "execute"], "status": "active", "llm_model": "gpt-4o-mini"}], "tools": []}, {"sub_ioa_id": "news", "agents": [{"agent_id": "news-verify-01", "display_name": "事实核查Agent", "provider": "news-org", "capabilities": ["fact_checking", "source_verification"], "actual_capabilities": ["fact_checking"], "protocols": ["MCP"], "reputation_score": 0.82, "permission_scope": ["read", "execute"], "status": "active", "llm_model": "gpt-4o-mini"}], "tools": []}], "topology": {"style": "chain", "edges": []}, "shared_knowledge": {"enabled": true, "pre_existing_entries": []}},
