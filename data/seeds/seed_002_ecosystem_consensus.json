            "actual_capabilities": ["clinical_analysis", "diagnosis_support"],
            "protocols": ["A2A", "MCP"],
            "reputation_score": 0.85,
            "permission_scope": ["read", "execute"],
            "status": "active",
            "llm_model": "gpt-4o-mini"
          },
          {
            "agent_id": "healthcare-drug-01",
            "display_name": "药物研发顾问",
            "provider": "healthcare-org",
            "capabilities": ["drug_development", "clinical_trial"],
            "actual_capabilities": ["drug_development", "clinical_trial"],
            "protocols": ["A2A", "MCP"],
            "reputation_score": 0.8,
            "permission_scope": ["read", "execute"],
            "status": "active",
            "llm_model": "gpt-4o-mini"
          }
        ],
        "tools": [
          {
            "tool_name": "lookup_drug_info",
            "tool_type": "database",
            "description": "查询药物审批和临床试验信息",
            "risk_level": "MEDIUM"
          }
        ]
      },
      {
        "sub_ioa_id": "news",
        "agents": [
          {
            "agent_id": "news-aggregator-01",
            "display_name": "新闻聚合分析师",
            "provider": "news-org",
            "capabilities": ["news_aggregation", "cross_platform"],
            "actual_capabilities": ["news_aggregation", "cross_platform"],
            "protocols": ["A2A", "MCP"],
            "reputation_score": 0.7,
            "permission_scope": ["read", "execute"],
            "status": "active",
            "llm_model": "gpt-4o-mini"
          },
          {
            "agent_id": "news-factcheck-01",
            "display_name": "事实核查员",
            "provider": "news-org",
