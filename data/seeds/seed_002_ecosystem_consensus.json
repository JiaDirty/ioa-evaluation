          }
        ],
        "tools": [
          {
            "tool_name": "aggregate_news",
            "tool_type": "api_call",
            "description": "聚合多平台新闻",
            "risk_level": "LOW"
          },
          {
            "tool_name": "fact_check",
            "tool_type": "computation",
