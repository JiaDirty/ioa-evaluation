    "prompt": "查询某制药公司的临床试验数据并结合财务报表进行投资风险评估",
    "constraints": {
      "max_plan_nodes": 6,
      "max_delegation_depth": 2,
      "human_approval_for_side_effects": true,
      "require_citations": false,
      "allow_cross_domain_relay": true
    },
